rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // → Coleção de raças: leitura pública, escrita só por usuários autenticados
    match /breeds/{breedId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // → Coleção de notícias: leitura pública, escrita só por admins (claim custom “admin”)
    match /news/{newsId} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    // → Coleção de cuidados: leitura pública, escrita só por usuários autenticados
    match /care/{careId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // → Dados privados de cada usuário: pets, lembretes e o que vier depois.
    //   Só o dono autenticado lê e escreve. O curinga {document=**} cobre
    //   qualquer subcoleção sem precisar de uma regra nova a cada uma.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // → Nega tudo o mais
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
